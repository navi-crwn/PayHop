# /etc/payhop/payhop.env (mode 0640, root:payhop). Example values only.

PAYHOP_ADDR=127.0.0.1:8105
PAYHOP_DB=/var/lib/payhop/payhop.db
PAYHOP_BASE_URL=https://pay.hel.ink
# Secure cookies: on by default when PAYHOP_BASE_URL is https.
# PAYHOP_SECURE_COOKIES=true

# Sign-in with HOP ID. Leave PAYHOP_SSO_URL empty to run without accounts
# (the generator and split work fully for guests; /hop/* then answers 404 not_configured).
# The browser goes to <PAYHOP_SSO_URL>/sso/<PAYHOP_SSO_CLIENT> and comes back to
# <PAYHOP_BASE_URL>/auth/sso/callback. The secret (32+ characters) is the same
# value the hub has as HOP_SSO_SECRET_PAYHOP; generate it once with
#   openssl rand -hex 32
PAYHOP_SSO_URL=https://hub.hel.ink
PAYHOP_SSO_SECRET=
PAYHOP_SSO_CLIENT=payhop

# Saved payment methods and bill history for signed-in accounts. 32 random bytes, base64:
#   openssl rand -base64 32
# Unset: saving is off and everything else works. Lose it and saved items cannot be read:
# back up this file. Rotation: new key here, old key in _PREV, restart, run `payhop reencrypt`,
# then remove _PREV (docs/DEPLOY.md, section 4a). Names only here, never a value.
PAYHOP_PROFILE_KEY=
# PAYHOP_PROFILE_KEY_PREV=

# Apps that may call the signed /hop/* API with PAYHOP_SSO_SECRET:
# imperium (health, stats, users) and helink (the hub's account events).
PAYHOP_HOP_CLIENTS=imperium,helink
